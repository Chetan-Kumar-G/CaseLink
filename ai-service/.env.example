# auto = use sentence-transformers if installed, else the lexicon engine
AI_ENGINE=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Leave empty to use each engine's default (transformer 0.62, lexicon 0.30)
SEMANTIC_THRESHOLD=
# Shared secret; must match AI_SERVICE_KEY in backend/.env
SERVICE_KEY=
ENV=development
