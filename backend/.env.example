# ---- CaseLink API configuration ----
NODE_ENV=development
PORT=4000

# Leave MONGO_URI empty in development to run a local MongoDB automatically
# (mongodb-memory-server). Data is stored in DEV_DB_PATH and survives restarts;
# it is seeded with synthetic data the first time. Set DEV_DB_PATH=memory for a
# throwaway database that is re-seeded on every start.
# For a real MongoDB use e.g. mongodb://127.0.0.1:27017/caselink
MONGO_URI=
DEV_DB_PATH=.data/db

# Required in production (in development, random values are generated once and
# kept in .data/dev-secrets.json). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Pepper used when hashing complainant identifiers for duplicate detection.
IDENTITY_PEPPER=

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# Python AI service (multilingual similarity).
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret; must match SERVICE_KEY in ai-service/.env (optional in dev).
AI_SERVICE_KEY=
AI_TIMEOUT_MS=8000

# Seed accounts password (development only). All seeded users share it.
SEED_PASSWORD=CaseLink@2026

# Seed automatically on start when the database is empty (always on for in-memory DB).
AUTO_SEED=true

# Set to 1 when running behind a reverse proxy (for correct client IPs in audit logs).
TRUST_PROXY=0

# Public URL of the web app (used in notification emails).
APP_URL=http://localhost:5173

# Optional email notifications, e.g. smtp://user:pass@smtp.example.com:587
# Leave empty to deliver notifications in-app only (emails are logged).
SMTP_URL=
MAIL_FROM=CaseLink <no-reply@caselink.local>

# How often (minutes) the escalation job checks deadlines.
ESCALATION_INTERVAL_MIN=5

# Demo deployments only: seed synthetic data into an empty database, show the
# demo accounts on the login page and enable demo controls (also in production).
DEMO_MODE=false

# Serve the built frontend (frontend/dist) from this API — one origin for hosting.
SERVE_WEB=false
WEB_DIST=../frontend/dist

# Access log format: dev | combined | none (default: dev locally, combined in production)
LOG_FORMAT=

# Serverless (Vercel) only — see README → Deployment
# CRON_SECRET=          # Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/tick
# DEMO_RESET_TOKEN=     # with DEMO_MODE=true, enables POST /api/demo/reset (header x-demo-token)
